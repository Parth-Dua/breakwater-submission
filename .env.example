# Local Convex tooling (replace with your development deployment).
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Next.js browser connection, used when the frontend is scaffolded.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set ANTHROPIC_API_KEY in this project's Convex environment only.
# Jev classifier: set transport and its key in Convex, never NEXT_PUBLIC_*.
# BREAKWATER_JEV_TRANSPORT=typesafe  (uses TYPESAFE_API_KEY)
# BREAKWATER_JEV_TRANSPORT=openrouter  (uses OPENROUTER_API_KEY)
# Jev credentials are required for classification; missing credentials leave memory for review.
